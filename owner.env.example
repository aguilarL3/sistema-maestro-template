# Copiá este archivo a owner.env y completalo (después: ./personalize.sh)
OWNER="Tu Nombre Completo"
OWNER_EMAIL="tu@email.com"
OWNER_GITHUB="tu-usuario-github"

# ── Modo del vault ───────────────────────────────────────────────────────────
# personal → un solo dueño humano (por defecto). Nada más que configurar.
# equipo   → varias personas con sus propias máquinas y cuentas.
#            Activa la capa multi-persona: carpetas de diario por persona y
#            CODEOWNERS. Ver SOP Git y Flujo de Trabajo §11.
VAULT_MODE=personal

# Solo en modo equipo. Nombres como los querés ver en Obsidian (se crea una
# carpeta 05 Diario/<Nombre>/ por cada uno). Separados por coma.
# Ej: TEAM_MEMBERS="Persona A,Persona B,Persona C"
TEAM_MEMBERS=""
